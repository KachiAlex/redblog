generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model Creator {
  id            String   @id @default(cuid())
  igUserId      String   @unique
  igUsername    String   @unique
  igProfilePic  String?
  accessToken   String
  refreshToken  String?
  tokenExpiry   DateTime?
  scannedFrom   String   @default("oauth")
  connectedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt

  posts       Post[]
  blogPage    BlogPage?
  analytics   Analytics[]
  campaigns      Campaign[]
  scheduledPosts ScheduledPost[]
}

model Post {
  id           String    @id @default(cuid())
  creatorId    String
  creator      Creator   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  igPostId     String    @unique
  permalink    String
  embedHtml    String?
  embedTitle   String?
  caption      String?
  thumbnailUrl String?
  videoUrl     String?
  videoFilePath String?
  mediaType    String    @default("VIDEO")
  source       String    @default("oauth")
  publishedAt  DateTime
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([creatorId])
  @@index([publishedAt])

  analytics Analytics[]
}

model BlogPage {
  id            String   @id @default(cuid())
  creatorId     String   @unique
  creator       Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  slug          String   @unique
  customDomain  String?
  themePrimary  String   @default("#ec4899")
  themeAccent   String   @default("#f97316")
  themeLayout   String   @default("grid")
  title         String?
  bio           String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Campaign {
  id            String   @id @default(cuid())
  creatorId     String
  creator       Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  context       String
  cadence       String   // daily | weekly | monthly
  tone          String?
  startDate     DateTime
  endDate       DateTime
  status        String   @default("draft") // draft | scheduled | completed | canceled
  textProvider  String   @default("deepseek") // openai | deepseek | kimi
  imageProvider String   @default("openai-dalle3") // openai-dalle3 | openai-dalle2 | together | none
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  posts ScheduledPost[]

  @@index([creatorId])
}

model ScheduledPost {
  id            String    @id @default(cuid())
  creatorId     String
  creator       Creator   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  campaignId    String?
  campaign      Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  caption       String
  imagePrompt   String?
  imageFilePath String?
  scheduledFor  DateTime
  status        String    @default("draft") // draft | scheduled | publishing | published | failed
  igMediaId     String?
  publishedAt   DateTime?
  error         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([creatorId])
  @@index([campaignId])
  @@index([scheduledFor])
  @@index([status])
}

model Analytics {
  id          String   @id @default(cuid())
  creatorId   String
  creator     Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  postId      String?
  post        Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  pageViews   Int      @default(0)
  date        DateTime @default(now())

  @@index([creatorId])
  @@index([date])
}
