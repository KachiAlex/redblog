# ─── Database (Neon Postgres) ───────────────────────────────────────────────
# Pooled connection (used by the app at runtime)
DATABASE_URL="postgresql://user:pass@host/db?pgbouncer=true&connect_timeout=15"
# Direct connection (used by Prisma migrations / db push)
DIRECT_DATABASE_URL="postgresql://user:pass@host/db"

# ─── Instagram OAuth ────────────────────────────────────────────────────────
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""
INSTAGRAM_REDIRECT_URI="http://localhost:3000/api/auth/callback/instagram"
# Webhook verification token (for the Instagram Graph API webhook)
INSTAGRAM_WEBHOOK_VERIFY_TOKEN="redblog_verify_token"
# Optional: Meta App access token for oEmbed calls
META_APP_ACCESS_TOKEN=""

# ─── Token encryption ───────────────────────────────────────────────────────
# 32+ char secret used to encrypt OAuth access tokens at rest.
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY="default-dev-key-change-in-production-32bytes"

# ─── App URL ────────────────────────────────────────────────────────────────
# Public base URL of the deployment. Used to build absolute image URLs for
# Instagram to fetch during the publish cron job.
APP_BASE_URL="http://localhost:3000"
# Legacy alias (still used by sitemap/robots/settings). Keep in sync.
NEXTAUTH_URL="http://localhost:3000"

# ─── AI providers (text) ────────────────────────────────────────────────────
# At least one text provider must be configured.
OPENAI_API_KEY=""
DEEPSEEK_API_KEY=""
MOONSHOT_API_KEY=""

# ─── AI providers (images) ──────────────────────────────────────────────────
# OPENAI_API_KEY is reused for DALL-E. Together AI is optional.
TOGETHER_API_KEY=""

# ─── Vercel Blob (generated image storage) ──────────────────────────────────
# Required in production so Instagram can fetch generated images at publish time.
# Create a Blob store in the Vercel dashboard and copy the read/write token.
BLOB_READ_WRITE_TOKEN=""

# ─── Vercel Cron (scheduled publishing) ─────────────────────────────────────
# Secret that Vercel Cron sends as `Authorization: Bearer <CRON_SECRET>`.
# Generate with: openssl rand -hex 32
# Set the SAME value in the Vercel dashboard under Settings → Cron Jobs (or env vars).
CRON_SECRET=""

# ─── Paystack (credit purchases) ───────────────────────────────────────────
# Get these from https://dashboard.paystack.co/#/settings/developer
PAYSTACK_SECRET_KEY=""
